# LLM Engine (NVIDIA NIM / Groq / OpenRouter / OpenAI)
NVIDIA_API_KEY=<your_nvidia_or_groq_api_key>
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# External API Keys (Optional)
OPENWEATHER_API_KEY=<your_openweather_key>
NEWSAPI_API_KEY=<your_newsapi_key>
TOMTOM_API_KEY=<your_tomtom_key>
OPENROUTESERVICE_API_KEY=<your_openrouteservice_key>

# Gmail MCP FastMCP Tool Server (For sending & receiving itinerary/briefing emails)
# 1. GMAIL_USER: Your sender Gmail address
GMAIL_USER=your_email@gmail.com
# 2. GMAIL_APP_PASSWORD: 16-character Google App Password (NOT your regular Gmail password)
#    Generate it at: https://myaccount.google.com/apppasswords (Requires 2-Step Verification enabled)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# 3. RECIPIENT_EMAIL: Default recipient address to receive itineraries and briefings
RECIPIENT_EMAIL=your_recipient_email@gmail.com
# 4. SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587